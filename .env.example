# Groq API key from https://console.groq.com/keys (server-side only)
GROQ_API_KEY=your_groq_api_key_here

# A Groq model that supports BOTH image input and JSON schema structured outputs
GROQ_MODEL=your_groq_model_id_here

# Optional: a text-only Groq model with JSON schema support, used for pasted text
# only when GROQ_MODEL is rate limited (Groq rate limits are per model)
GROQ_TEXT_FALLBACK_MODEL=your_text_fallback_model_id_here